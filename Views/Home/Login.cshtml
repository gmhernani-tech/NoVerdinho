@model NoVerdinho.Models.Login.TratamentoLogin
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="body-cadastro-container">
    <div class="cadastro-card animate__animated animate__fadeIn">

        <div class="text-center mb-4">
            <h2 class="title-verde">No<span class="text-destaque">Verdinho</span></h2>
            <p class="text-muted">Acesse sua conta para gerenciar seu patamar financeiro.</p>
        </div>

        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-custom-erro">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.Erro
            </div>
        }

        <form asp-controller="Home" asp-action="ValidarLogin" method="post">

            <div class="form-floating mb-3">
                <input type="email" name="email" class="form-control input-custom" id="Email" placeholder="nome@exemplo.com" required>
                <label for="Email">E-mail</label>
            </div>

            <div class="form-floating mb-4">
                <input type="password" name="senha" class="form-control input-custom" id="Senha" placeholder="Senha" required>
                <label for="Senha">Senha</label>
            </div>

            <button type="submit" class="btn-primary-noverdinho w-100 py-3 mb-3">
                ENTRAR NO SISTEMA
            </button>

        </form>

        <div class="text-center">
            <span class="text-muted small">Não possui uma conta?</span> <br>
            <a asp-action="Cadastro" class="link-verde">Criar minha conta agora</a>
        </div>

        <hr class="my-4">

        <a asp-controller="Home" asp-action="Index" class="btn-voltar-discreto w-100">
            <i class="fas fa-arrow-left"></i> Voltar para Home
        </a>

    </div>
</div>