@model NoVerdinho.Models.Cadastro.TratamentoCadastro
@{
    ViewData["Title"] = "Cadastro - NoVerdinho";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="body-cadastro-container">
    <div class="cadastro-card animate__animated animate__zoomIn">
        
        <div class="text-center mb-4">
            <h2 class="title-verde">No<span class="text-destaque">Verdinho</span></h2>
            <p class="text-muted">Crie a sua conta e transforme a sua vida financeira.</p>
        </div>

        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-custom-erro">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.Erro
            </div>
        }

        <form asp-controller="Home" asp-action="CadastroNovoUsuario" method="post" onsubmit="return enviarFormulario(event)">
            
            <div class="form-floating mb-3">
                <input type="text" name="nome" class="form-control input-custom" id="nome" placeholder="Nome Completo" required>
                <label for="nome">Nome Completo</label>
            </div>

            <div class="form-floating mb-3">
                <input type="text" name="cpfcnpj" class="form-control input-custom" id="cpfcnpj" oninput="formatarDocumento(this)" placeholder="CPF ou CNPJ" maxlength="18" required>
                <label for="cpfcnpj">CPF / CNPJ</label>
            </div>

            <div class="form-floating mb-3">
                <input type="email" name="email" class="form-control input-custom" id="email" placeholder="nome@exemplo.com" required>
                <label for="email">E-mail</label>
            </div>

            <div class="form-floating mb-3">
                <select name="regime_trabalho" class="form-select input-custom" id="regime" required>
                    <option value="" selected disabled>Selecione o regime</option>
                    <option value="0">CLT</option>
                    <option value="1">PJ</option>
                </select>
                <label for="regime">Regime de Trabalho</label>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input type="password" name="senha" class="form-control input-custom" id="senha" placeholder="Senha" required>
                        <label for="senha">Senha</label>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input type="password" name="confirmarSenha" class="form-control input-custom" id="confirmarsenha" placeholder="Confirmar" required>
                        <label for="confirmarsenha">Confirmar</label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-primary-noverdinho w-100 py-3 mb-3">
                CRIAR MINHA CONTA
            </button>

        </form>

        <div class="text-center">
            <span class="text-muted small">Já possui uma conta?</span> <br>
            <a asp-action="Login" class="link-verde">Fazer Login</a>
        </div>

        <hr class="my-4">

        <a asp-action="Index" class="btn-voltar-discreto w-100">
            <i class="fas fa-arrow-left"></i> Voltar para a Home
        </a>

    </div>
</div>
