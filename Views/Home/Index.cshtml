@{
    ViewData["Title"] = "Home";
}

<div class="header">
    <div class="animate__animated animate__fadeInLeft">
        <h1>
            Nós iremos trazer a <span class="text-highlight">saúde financeira</span><br>
            para a sua vida, te deixando<br>
            em outro <span class="text-highlight">patamar</span>.
        </h1>

        <p style="font-size: 1.2rem; margin-bottom: 30px; opacity: 0.9;">
            Gestão inteligente e descomplicada para o seu dinheiro render mais.
        </p>

        <a asp-controller="Home" asp-action="Cadastro" class="btn-cta">
            Começar Agora Gratis
        </a>
    </div>
</div>

<div class="container mt-5 py-5">
    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <i class="bi bi-shield-check fs-1" style="color: #7DBA4E;"></i>
            <h3 class="mt-3 fw-bold" style="color: #2D461E;">Seguro</h3>
            <p class="text-muted">Seus dados e rendimentos protegidos com tecnologia de ponta.</p>
        </div>
        <div class="col-md-4 mb-4">
            <i class="bi bi-graph-up-arrow fs-1" style="color: #7DBA4E;"></i>
            <h3 class="mt-3 fw-bold" style="color: #2D461E;">Sustentável</h3>
            <p class="text-muted">Planejamento focado em economia consciente e futuro sólido.</p>
        </div>
        <div class="col-md-4 mb-4">
            <i class="bi bi-lightning-charge fs-1" style="color: #7DBA4E;"></i>
            <h3 class="mt-3 fw-bold" style="color: #2D461E;">Simples</h3>
            <p class="text-muted">Interface intuitiva pensada para facilitar sua gestão diária.</p>
        </div>
    </div>
</div>

<div class="container-fluid py-5" style="background-color: #f8f9fa;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4" style="color: #2D461E;">Tudo o que você precisa em <span style="color: #7DBA4E;">um só lugar</span></h2>

                <div class="d-flex mb-4">
                    <div class="me-3"><i class="bi bi-calculator-fill fs-3 text-success"></i></div>
                    <div>
                        <h5 class="fw-bold">Calculadora CLT vs PJ</h5>
                        <p class="text-muted">Descubra seu salário líquido real. Calculamos INSS, IRRF e descontos personalizados para você não ter surpresas.</p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="me-3"><i class="bi bi-search-heart fs-3 text-success"></i></div>
                    <div>
                        <h5 class="fw-bold">Radar de Preços</h5>
                        <p class="text-muted">Nosso sistema compara os preços dos produtos nos mercados da sua região. Economia real direto no carrinho.</p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="me-3"><i class="bi bi-pie-chart-fill fs-3 text-success"></i></div>
                    <div>
                        <h5 class="fw-bold">Dashboard de Gastos</h5>
                        <p class="text-muted">Visualize para onde seu dinheiro está indo com gráficos claros e alertas de limite de orçamento.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="p-5 rounded-4 shadow-lg bg-white">
                    <i class="bi bi-device-ssd" style="font-size: 8rem; color: #C7E0B4;"></i>
                    <p class="fw-bold mt-3 text-muted">A tecnologia a favor do seu bolso.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5 text-center">
    <div class="p-5 rounded-5 shadow" style="background: linear-gradient(135deg, #2D461E, #7DBA4E); color: white;">
        <h2 class="fw-bold mb-3">Pronto para ficar "No Verdinho"?</h2>
        <p class="mb-4">Junte-se a milhares de pessoas que já transformaram sua relação com o dinheiro.</p>
        <a asp-controller="Home" asp-action="Cadastro" class="btn btn-light btn-lg px-5 fw-bold text-success rounded-pill">
            Criar minha conta agora
        </a>
    </div>
</div>